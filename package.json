{
  "name": "impulse-math-device-ts",
  "version": "0.1.0",
  "description": "Native memory: NVIDIA CUDA™ and RAM bindings for Node.js",
  "keywords": [
    "NVIDIA",
    "CUDA",
    "GPU"
  ],
  "homepage": "http://github.com/HudHatman/impulse-ml",
  "author": "Michał Baniowski",
  "contributors": [
    {
      "name": "Michał Baniowski",
      "email": "michal.baniowski@gmail.com"
    }
  ],
  "main": "dist/impulse-ml.js",
  "type": "commonjs",
  "directories": {
    "src": "src"
  },
  "scripts": {
    "preinstall": "node-gyp clean || true; node-gyp configure build",
    "install": "node-gyp rebuild",
    "build": "npm run build-prod && npm run build-dev",
    "build-dev": "node-gyp rebuild && webpack --config ./configs/dev.js",
    "build-dev-ts": "webpack --config ./configs/dev.js",
    "build-prod": "webpack --config ./configs/prod.js",
    "prettier-write": "prettier --write \"src/typescript/**/*.ts\"",
    "test": "jest",
    "lint": "eslint . --ext .ts",
    "lint-fix": "eslint . --ext .ts --fix",
    "docs": "typedoc"
  },
  "license": "MIT",
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@tsconfig/node20": "^20.1.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.2",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "babel-loader": "^10.1.1",
    "eslint": "^10.4.1",
    "fast-check": "4.8.0",
    "jest": "^30.4.2",
    "node-loader": "^2.1.0",
    "prettier": "^3.8.3",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3"
  },
  "dependencies": {
    "csvtojson": "^2.0.10",
    "gl": "8.1.6",
    "node-addon-api": "^8.5.0"
  }
}
